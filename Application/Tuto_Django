def lieu_observation(appareil=None):
    """Où se trouve le bras : la position GPS qu'il a rapportée (Partie 6.2), sinon le lieu
    par défaut des réglages. Indispensable pour l'ISS : 10 km d'écart = 1,5° d'erreur."""

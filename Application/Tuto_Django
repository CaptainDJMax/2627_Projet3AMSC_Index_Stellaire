## 2.6 L'API de détail d'un objet

On ajoute une URL qui renvoie tout ce qu'il faut pour la **fiche d'un astre** : son contenu, sa position actuelle, sa trajectoire, ses levers et couchers. L'appli l'appellera quand on touche un astre sur la carte, et l'appareil s'en servira pour planifier son suivi.

### 2.6.1 La vue

**Où écrire** : dans `ciel/views.py`. Remplace tout le contenu par cette version, qui garde `liste_objets` telle quelle et ajoute `detail_objet` :

```python
import logging

from django.conf import settings
from django.http import JsonResponse
from django.views.decorators.http import require_GET

from .astro import levers_couchers, maintenant, trajectoire
from .models import ObjetCeleste

logger = logging.getLogger(__name__)


def _entier(request, nom, defaut, mini, maxi):
    """Lit un paramètre d'URL entier, borné entre mini et maxi."""
    try:
        valeur = int(request.GET.get(nom, defaut))
    except ValueError:
        return defaut
    return max(mini, min(maxi, valeur))


@require_GET
def liste_objets(request):
    """Positions actuelles de tous les objets calculables."""
    lieu = settings.LIEU_PAR_DEFAUT
    instant = maintenant()
    objets = []

    for objet in ObjetCeleste.objects.exclude(identifiant_skyfield=""):
        try:
            elevation, azimut = objet.position(lieu=lieu, instant=instant)
        except (KeyError, ValueError):
            # Un identifiant faux ne doit pas casser toute la carte
            logger.warning(
                "Identifiant Skyfield invalide pour %r : %r",
                objet.nom,
                objet.identifiant_skyfield,
            )
            continue
        objets.append(
            {
                "id": objet.id,
                "nom": objet.nom,
                "categorie": objet.categorie,
                "elevation": round(elevation, 2),
                "azimut": round(azimut, 2),
                "visible": elevation > 0,
            }
        )

    return JsonResponse(
        {"instant": instant.utc_iso(), "lieu": lieu, "objets": objets},
        json_dumps_params={"ensure_ascii": False},
    )


@require_GET
def detail_objet(request, objet_id):
    """Fiche complète d'un objet : contenu, position, trajectoire,
    levers et couchers. Paramètres facultatifs : ?duree=24 (heures,
    1 à 72) et ?pas=10 (minutes, 1 à 60)."""
    try:
        objet = ObjetCeleste.objects.get(pk=objet_id)
    except ObjetCeleste.DoesNotExist:
        return JsonResponse({"erreur": "Objet introuvable."}, status=404)
    if not objet.identifiant_skyfield:
        return JsonResponse(
            {"erreur": "Cet objet n'a pas d'identifiant de calcul."}, status=404
        )

    lieu = settings.LIEU_PAR_DEFAUT
    duree = _entier(request, "duree", 24, 1, 72)
    pas = _entier(request, "pas", 10, 1, 60)
    instant = maintenant()
    calcul = (
        objet.identifiant_skyfield,
        lieu["latitude"],
        lieu["longitude"],
        lieu.get("altitude_m", 0),
    )

    try:
        elevation, azimut = objet.position(lieu=lieu, instant=instant)
        points = trajectoire(*calcul, debut=instant, duree_h=duree, pas_min=pas)
        evenements = levers_couchers(*calcul, debut=instant, duree_h=duree)
    except (KeyError, ValueError):
        logger.warning(
            "Identifiant Skyfield invalide pour %r : %r",
            objet.nom,
            objet.identifiant_skyfield,
        )
        return JsonResponse({"erreur": "Identifiant de calcul invalide."}, status=500)

    return JsonResponse(
        {
            "id": objet.id,
            "nom": objet.nom,
            "categorie": objet.categorie,
            "description": objet.description,
            "image": objet.image.url if objet.image else None,
            "constellations": [c.nom for c in objet.constellations.all()],
            "instant": instant.utc_iso(),
            "lieu": lieu,
            "position": {
                "elevation": round(elevation, 2),
                "azimut": round(azimut, 2),
                "visible": elevation > 0,
            },
            "levers_couchers": evenements,
            "trajectoire": points,
        },
        json_dumps_params={"ensure_ascii": False},
    )
```

Ce qu'il faut retenir :
- **Un seul `instant`** est calculé au début et réutilisé pour la position, la trajectoire et les levers/couchers, donc les trois sont cohérents entre eux.
- **`_entier`** lit les paramètres `?duree=` et `?pas=` en les bornant (1 à 72 h, 1 à 60 min). Sans ces bornes, quelqu'un pourrait demander `?duree=100000` et bloquer le serveur. Les 72 h couvrent largement les 48 h d'autonomie de l'appareil.
- **Erreurs en JSON** : un objet inconnu ou non calculable renvoie `{"erreur": ...}` avec le code 404, et non une page HTML, pour que l'appli puisse lire l'erreur proprement.
- **`constellations`** utilise le `related_name` défini en 1.2 : la fiche de l'étoile liste ses constellations. Le champ reste vide tant que tu n'as rien rattaché dans l'admin.
- **`image`** vaut `null` si l'objet n'en a pas encore, ce qui sera le cas jusqu'à la Partie 10.


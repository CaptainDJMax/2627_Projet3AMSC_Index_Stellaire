        """(élévation, azimut) en degrés, ou None si l'objet n'a pas
        d'identifiant Skyfield. lieu : dict latitude/longitude/altitude_m."""
        if not self.identifiant_skyfield:
            return None
        lieu = lieu or settings.LIEU_PAR_DEFAUT

```python
import secrets
from datetime import timedelta

from django.db import models
from django.db.models import Q
from django.utils import timezone

from ciel.models import ObjetCeleste

# Au-delà de ce délai sans nouvelles, l'appareil est considéré hors ligne
DELAI_HORS_LIGNE = timedelta(seconds=10)


def nouveau_jeton():
    """Secret propre à l'appareil : l'ESP32 le présente à chaque requête."""
    return secrets.token_urlsafe(32)


class Appareil(models.Model):
    class Mode(models.TextChoices):
        REPOS = "repos", "Au repos"
        DEPLACEMENT = "deplacement", "En déplacement"
        SUIVI = "suivi", "En suivi"
        ERREUR = "erreur", "Erreur"

    nom = models.CharField(max_length=100, default="Index Stellaire")
    jeton = models.CharField(max_length=64, unique=True, default=nouveau_jeton, editable=False)

    # Dernier état rapporté par l'appareil lui-même
    derniere_vue = models.DateTimeField(null=True, blank=True)
    azimut = models.FloatField(null=True, blank=True)  # degrés, 0 = nord, sens horaire
    elevation = models.FloatField(null=True, blank=True)  # degrés, négatif = sous l'horizon
    batterie = models.PositiveSmallIntegerField(null=True, blank=True)  # pourcentage
    mode = models.CharField(max_length=20, choices=Mode.choices, default=Mode.REPOS)

    def __str__(self):
        return self.nom

    @property
    def connecte(self):
        return self.derniere_vue is not None and timezone.now() - self.derniere_vue < DELAI_HORS_LIGNE


class Commande(models.Model):
    """Ce que l'utilisateur demande au bras : pointer un objet, en continu."""

    appareil = models.ForeignKey(Appareil, on_delete=models.CASCADE, related_name="commandes")
    objet = models.ForeignKey(ObjetCeleste, on_delete=models.CASCADE, related_name="commandes")
    cree_le = models.DateTimeField(auto_now_add=True)
    active = models.BooleanField(default=True)

    class Meta:
        ordering = ["-cree_le"]
        constraints = [
            # Au plus une commande active par appareil
            models.UniqueConstraint(
                fields=["appareil"], condition=Q(active=True), name="une_commande_active_par_appareil"
            ),
        ]

    def __str__(self):
        return f"{self.appareil} → {self.objet}" + ("" if self.active else " (terminée)")
```

Les choix de conception :
- **`Appareil` garde le dernier état rapporté** (position, batterie, mode) et la date de dernière vue. L'interface peut ainsi afficher l'état sans interroger le matériel.
- **`jeton`** : un secret par appareil, généré automatiquement. `editable=False` le protège d'une modification accidentelle dans l'admin.
- **`connecte` est calculé, pas stocké** : « vu il y a moins de 10 s ». Rien à maintenir à jour si l'appareil disparaît brutalement.
- **`Commande` garde l'historique** : on désactive l'ancienne commande au lieu de la supprimer. La contrainte `UniqueConstraint` garantit **au niveau de la base** qu'il n'y a jamais deux commandes actives pour un même appareil, même en cas de bug.
- **`mode`** est rapporté par l'appareil lui-même, et non déduit par le serveur.

### Étape 3 : `appareil/services.py` (nouveau fichier)

La logique du pointage, séparée de HTTP : on peut la tester seule.

```python
"""Logique métier du pointage, indépendante de HTTP (testable seule)."""

import math

from django.conf import settings
from django.db import transaction

from ciel.astro import altaz

from .models import Appareil, Commande


def lieu_observation():
    """Où se trouve le bras. Pour l'instant : le lieu par défaut des réglages.
    Plus tard (Partie 13), ce sera la position GPS rapportée par l'appareil."""
    return settings.LIEU_PAR_DEFAUT


def appareil_principal():
    """Le projet est mono-appareil : on prend le premier. None s'il n'y en a pas."""
    return Appareil.objects.order_by("id").first()


def commande_active(appareil):
    return appareil.commandes.filter(active=True).select_related("objet").first()


@transaction.atomic
def definir_cible(appareil, objet):
    """Remplace la commande en cours par un pointage sur `objet`."""
    appareil.commandes.filter(active=True).update(active=False)
    return Commande.objects.create(appareil=appareil, objet=objet)


def arreter(appareil):
    appareil.commandes.filter(active=True).update(active=False)


def cible_de(commande, instant=None):
    """Où doit pointer le bras maintenant pour viser l'objet de la commande.

    L'élévation peut être négative : le bras est une structure ouverte, il sait
    pointer à travers la Terre (objets de l'autre côté du globe)."""
    lieu = lieu_observation()
    elevation, azimut = altaz(
        commande.objet.identifiant_skyfield,
        lieu["latitude"], lieu["longitude"], lieu["altitude_m"],
        instant,
    )
    return {"azimut": round(azimut, 3), "elevation": round(elevation, 3), "visible": elevation > 0}


def ecart_angulaire(a, b):
    """Angle (degrés) entre deux directions (azimut, élévation), par la trigonométrie sphérique."""
    az1, el1, az2, el2 = map(math.radians, (a[0], a[1], b[0], b[1]))
    c = math.sin(el1) * math.sin(el2) + math.cos(el1) * math.cos(el2) * math.cos(az1 - az2)
    return math.degrees(math.acos(max(-1.0, min(1.0, c))))
```

Points à noter :
- **`lieu_observation()`** est le **point d'extension** pour la Partie 13. Aujourd'hui, c'est Paris. Quand le GPS du bras existera, on changera cette seule fonction.
- **`@transaction.atomic`** : désactiver l'ancienne commande et créer la nouvelle se fait en bloc, sans état intermédiaire bancal.
- **L'écart angulaire** passe par la trigonométrie sphérique. Une simple différence des azimuts serait fausse près du zénith, ou autour de 360°. Les tests couvrent ces cas.

### Étape 4 : `appareil/views.py` (remplace le contenu)

```python
import json
import logging
import math

from django.http import JsonResponse
from django.utils import timezone
from django.views.decorators.csrf import csrf_exempt
from django.views.decorators.http import require_GET, require_POST

from ciel.astro import maintenant
from ciel.models import ObjetCeleste

from . import services
from .models import Appareil

logger = logging.getLogger(__name__)

INTERVALLE_MS = 1000  # cadence de synchronisation demandée à l'appareil


def _erreur(message, statut):
    return JsonResponse({"erreur": message}, status=statut)


# ===========================================================================
# Côté appareil (ESP32) : authentifié par un jeton, pas de session ni de CSRF
# ===========================================================================


def _appareil_authentifie(request):
    entete = request.headers.get("Authorization", "")
    if not entete.startswith("Bearer "):
        return None
    return Appareil.objects.filter(jeton=entete[7:].strip()).first()


def _nombre(corps, cle, mini, maxi):
    """Nombre optionnel du corps JSON, borné. ValueError s'il est invalide."""
    valeur = corps.get(cle)
    if valeur is None:
        return None
    if isinstance(valeur, bool) or not isinstance(valeur, (int, float)):
        raise ValueError(cle)
    if not math.isfinite(valeur) or not mini <= valeur <= maxi:
        raise ValueError(cle)
    return float(valeur)


def _commande_pour_appareil(appareil, instant):
    commande = services.commande_active(appareil)
    if commande is None:
        return None
    try:
        cible = services.cible_de(commande, instant)
    except (KeyError, ValueError):
        logger.warning("Cible impossible à calculer pour %s", commande.objet)
        return None
    return {
        "id": commande.id,
        "mode": "pointer",
        "objet": {"id": commande.objet.id, "nom": commande.objet.nom},
        "cible": cible,
    }


@csrf_exempt
@require_POST
def synchroniser(request):
    """L'appareil envoie son état et reçoit sa consigne, en un seul aller-retour."""
    appareil = _appareil_authentifie(request)
    if appareil is None:
        return _erreur("Jeton d'appareil manquant ou invalide.", 401)

    try:
        corps = json.loads(request.body or b"{}")
        if not isinstance(corps, dict):
            raise ValueError("corps")
        azimut = _nombre(corps, "azimut", -3600, 3600)  # la bague collectrice tourne sans fin
        elevation = _nombre(corps, "elevation", -90, 90)
        batterie = _nombre(corps, "batterie", 0, 100)
        mode = corps.get("mode", appareil.mode)
        if mode not in Appareil.Mode.values:
            raise ValueError("mode")
    except ValueError:
        return _erreur("Corps JSON invalide (azimut, elevation, batterie, mode).", 400)

    appareil.derniere_vue = timezone.now()
    appareil.mode = mode
    if azimut is not None:
        appareil.azimut = azimut % 360
    if elevation is not None:
        appareil.elevation = elevation
    if batterie is not None:
        appareil.batterie = round(batterie)
    appareil.save()

    instant = maintenant()
    return JsonResponse({
        "heure_serveur": instant.utc_iso(),
        "intervalle_ms": INTERVALLE_MS,
        "commande": _commande_pour_appareil(appareil, instant),
    })


# ===========================================================================
# Côté interface web : état, choix d'une cible, arrêt
# ===========================================================================


def _etat(appareil):
    """Ce que l'interface affiche : l'appareil, la commande en cours, l'écart."""
    if appareil is None:
        return {"appareil": None, "commande": None, "ecart_deg": None}

    commande = services.commande_active(appareil)
    resume_commande = None
    ecart = None
    if commande is not None:
        try:
            cible = services.cible_de(commande)
        except (KeyError, ValueError):
            cible = None
        resume_commande = {
            "objet": {"id": commande.objet.id, "nom": commande.objet.nom},
            "depuis": commande.cree_le.isoformat(),
            "cible": cible,
        }
        if cible and appareil.azimut is not None and appareil.elevation is not None:
            ecart = round(
                services.ecart_angulaire(
                    (appareil.azimut, appareil.elevation), (cible["azimut"], cible["elevation"])
                ),
                2,
            )

    return {
        "appareil": {
            "nom": appareil.nom,
            "connecte": appareil.connecte,
            "derniere_vue": appareil.derniere_vue.isoformat() if appareil.derniere_vue else None,
            "azimut": appareil.azimut,
            "elevation": appareil.elevation,
            "batterie": appareil.batterie,
            "mode": appareil.mode,
        },
        "commande": resume_commande,
        "ecart_deg": ecart,
    }


@require_GET
def etat_pointage(request):
    return JsonResponse(_etat(services.appareil_principal()))


@require_POST
def definir_commande(request):
    appareil = services.appareil_principal()
    if appareil is None:
        return _erreur("Aucun appareil enregistré.", 404)
    try:
        corps = json.loads(request.body or b"{}")
        objet_id = corps["objet_id"]
        if isinstance(objet_id, bool) or not isinstance(objet_id, int):
            raise ValueError("objet_id")
    except (ValueError, KeyError, TypeError):
        return _erreur("Corps JSON attendu : {\"objet_id\": <entier>}.", 400)

    objet = ObjetCeleste.objects.filter(pk=objet_id).exclude(identifiant_skyfield="").first()
    if objet is None:
        return _erreur("Objet introuvable ou sans identifiant Skyfield.", 404)

    services.definir_cible(appareil, objet)
    return JsonResponse(_etat(appareil))


@require_POST
def arreter_pointage(request):
    appareil = services.appareil_principal()
    if appareil is None:
        return _erreur("Aucun appareil enregistré.", 404)
    services.arreter(appareil)
    return JsonResponse(_etat(appareil))
```

Les choix de conception :
- **Un seul aller-retour par seconde** : l'appareil envoie son état *et* reçoit sa consigne dans la même requête `POST /api/appareil/sync/`. Pour l'ESP32, c'est la boucle la plus simple possible, et elle marche en HTTP ordinaire sur le Wi-Fi.
- **Le serveur calcule la cible** (azimut et élévation avec Skyfield), l'appareil l'exécute. L'ESP32 et le STM32 n'ont jamais besoin de connaître une éphéméride.
- **Deux mécanismes d'accès séparés.** L'appareil s'authentifie par **jeton** (`Authorization: Bearer ...`), sans cookie ni CSRF (`@csrf_exempt` ne s'applique qu'à lui). L'interface web, elle, est **protégée par CSRF**. En Partie 5, le code de session s'ajoutera du côté web sans toucher à l'appareil.
- **Validation stricte des entrées** : nombres finis, bornés (`nan`, `true` ou `"haut"` sont refusés avec une 400). Un firmware qui bugge ne peut pas corrompre la base.
- **Élévation négative acceptée** : c'est le cas « viser l'autre côté de la Terre » de ton cahier des charges.
- **L'azimut est ramené dans [0, 360[** : la bague collectrice permet de tourner sans fin, donc l'appareil peut rapporter 370°.


### Étape 4 : `ciel/static/ciel/carte.js`, charger et dessiner

Insère ce bloc **juste avant `Celestial.display({`** (il va à l'intérieur de la fonction `(function () { ... })();`, après `placer()`) :

```javascript
  // --- Nos objets (calculés par Skyfield côté serveur) -----------------------

  let objets = [];

  // Style de dessin par catégorie. Les étoiles sont déjà sur la carte (et déjà
  // nommées par la bibliothèque) : on se contente de les entourer.
  const STYLES = {
    planete: { forme: "disque", rayon: 5, couleur: "#ffd479", texte: "#ffe6ad", nom: true },
    etoile: { forme: "anneau", rayon: 8, couleur: "#7fb0ff", texte: "#a9c8ff", nom: false },
    amas: { forme: "anneau", rayon: 8, couleur: "#b79cff", texte: "#cdbcff", nom: true },
    satellite: { forme: "disque", rayon: 4, couleur: "#ff5a5a", texte: "#ff9a9a", nom: true },
  };

  function chargerObjets() {
    fetch(carte.dataset.urlObjets)
      .then(function (reponse) {
        if (!reponse.ok) throw new Error("HTTP " + reponse.status);
        return reponse.json();
      })
      .then(function (donnees) {
        objets = donnees.objets;
        Celestial.redraw();
      })
      .catch(function (erreur) {
        console.warn("Objets indisponibles :", erreur);
      });
  }

  // Appelée par d3-celestial à chaque rafraîchissement de la carte
  function dessinerObjets() {
    const ctx = Celestial.context;
    objets.forEach(function (o) {
      const position = [o.ra, o.dec]; // ascension droite, déclinaison (degrés)
      if (!Celestial.clip(position)) return; // sous l'horizon : hors du disque
      const pt = Celestial.mapProjection(position);
      const style = STYLES[o.categorie] || STYLES.etoile;

      ctx.save();
      ctx.beginPath();
      ctx.arc(pt[0], pt[1], style.rayon, 0, 2 * Math.PI);
      if (style.forme === "disque") {
        ctx.fillStyle = style.couleur;
        ctx.fill();
        ctx.lineWidth = 1.5;
        ctx.strokeStyle = "#05070d";
        ctx.stroke();
      } else {
        ctx.lineWidth = 1.5;
        ctx.strokeStyle = style.couleur;
        ctx.stroke();
      }
      if (style.nom) {
        ctx.font = "12px Helvetica, Arial, sans-serif";
        ctx.textAlign = "left";
        ctx.textBaseline = "bottom";
        ctx.fillStyle = style.texte;
        ctx.fillText(o.nom, pt[0] + style.rayon + 3, pt[1] - style.rayon + 2);
      }
      ctx.restore();
    });
  }

  // À déclarer AVANT Celestial.display : le callback est lancé quand la carte est prête
  Celestial.add({ type: "raw", callback: chargerObjets, redraw: dessinerObjets });
```

Comment ça fonctionne :
- **`Celestial.add({type:"raw"})`** : on s'accroche au cycle de dessin de la bibliothèque. `redraw` est rappelée à chaque rafraîchissement (glisser, zoom), donc nos objets suivent la carte.
- **`callback: chargerObjets`** : d3-celestial l'appelle quand la carte est prête. On évite ainsi de dessiner avant que la carte existe.
- **`Celestial.clip(position)`** : indique si le point est sur la face visible du disque. Un objet sous l'horizon (comme Aldébaran en journée) est ignoré, sans calcul de notre part.
- **`Celestial.mapProjection([ra, dec])`** : convertit des coordonnées célestes en pixels. Elle tient compte de la rotation du ciel pour Paris, du zoom et du glisser.
- **Pas de nom pour les étoiles** : la bibliothèque affiche déjà celui des étoiles brillantes, et un doublon surchargeait l'écran.


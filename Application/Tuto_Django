```javascript
(function () {
  "use strict";

  const carte = document.getElementById("carte");
  const lieu = JSON.parse(document.getElementById("donnees-lieu").textContent);
  const POSITION = [lieu.latitude, lieu.longitude];

  // La carte est un disque : on la dimensionne sur le plus petit côté de l'écran
  function taille() {
    return Math.floor(Math.min(window.innerWidth, window.innerHeight)) - 16;
  }

  function placer() {
    const t = taille();
    carte.style.width = t + "px";
    carte.style.height = t + "px";
    carte.style.left = Math.round((window.innerWidth - t) / 2) + "px";
    carte.style.top = Math.round((window.innerHeight - t) / 2) + "px";
    return t;
  }

  Celestial.display({
    container: "carte",
    datapath: carte.dataset.datapath,
    width: placer(),
    projection: "orthographic",
    interactive: true,
    controls: false,

    // Ciel vu du lieu d'observation, à l'instant présent, centré sur le zénith
    location: true,
    geopos: POSITION,
    follow: "zenith",
    settimezone: false, // sinon la bibliothèque interroge un service externe

    // Formulaire interne : présent mais caché (voir carte.css)
    form: true,

    stars: {
      limit: 5,
      colors: true,
      designation: false,
      propername: true,
      propernameType: "fr",
      propernameLimit: 1.3,
      propernameStyle: {
        fill: "#cfd6e4",
        font: "11px Helvetica, Arial, sans-serif",
        align: "left",
        baseline: "top",
      },
    },
    dsos: { show: false },
    planets: { show: false }, // on dessinera les nôtres (calculées par Skyfield)
    constellations: {
      names: true,
      namesType: "fr",
      lines: true,
      nameStyle: {
        fill: "#5d6a88",
        align: "center",
        baseline: "middle",
        font: [
          "11px Helvetica, Arial, sans-serif",
          "10px Helvetica, Arial, sans-serif",
          "10px Helvetica, Arial, sans-serif",
        ],
      },
      lineStyle: { stroke: "#6f7da0", width: 1, opacity: 0.5 },
    },
    mw: { show: true, style: { fill: "#aab4d4", opacity: 0.06 } },
    lines: {
      graticule: { show: false },
      equatorial: { show: false },
      ecliptic: { show: false },
    },
    background: { fill: "#05070d", opacity: 1, stroke: "#05070d", width: 0 },
    horizon: { show: false },
    daylight: { show: false },
  });

  window.addEventListener("resize", function () {
    Celestial.resize({ width: placer() });
  });
})();
```

Les choix importants :
- **Projection orthographique** : le ciel est vu comme un hémisphère, un disque, ce qui est proche de l'esprit Sky Guide. La stéréographique débordait de l'écran lors de mes essais.
- **`location: true` + `geopos` + `follow: "zenith"`** : la carte est calculée pour Paris, à l'instant présent, et centrée sur le point au-dessus de ta tête.
- **`settimezone: false`** : par défaut, la bibliothèque envoie les coordonnées du lieu à un service tiers pour trouver le fuseau horaire. Pour un projet qui connaît ta position, on ne veut pas ça.
- **`planets: { show: false }`** : les positions de planètes de la bibliothèque sont approximatives. On dessinera les nôtres, calculées par Skyfield, en 3.2.
- **`limit: 5`** : seules les étoiles de magnitude ≤ 5 sont dessinées, ce qui garde la carte lisible et rapide sur téléphone.

